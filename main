#include <stdio.h>
int isLower(char);

int main(void){

	char letter;
	int result;

	letter = 'a';
	result = isLower(letter);
	printf("isLower(%c) = %d\n",letter, result);

	return 0;
}

int isLower(char letter);
isLower('5') returns 0
isLower('T') returns 0
isLower('a') returns any number that isn't 0

char toUpper(char letter);
toUpper('5') returns '5'
toUpper('a') returns 'A'
toUpper('B') returns 'B'

int biggest(int first, int second, int third);
biggest(2, 5, 15) returns 15
biggest(25, 3, 18) returns 25

double ticketPrice(int age, int hasCoupon,int dayOfWeek);